# --- AIONIX NEXUS ---------------------------------------------------------
# Assina os tokens de sessao (HMAC-SHA256). OBRIGATORIO em producao, minimo
# 32 caracteres — sem ele o app se recusa a emitir sessao. Trocar o valor
# invalida todas as sessoes ativas. Gere com:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
NEXUS_SECRET=

# Postgres. Provisionado pelo Marketplace da Vercel (Neon) e injetado
# automaticamente no projeto — puxe para ca com `vercel env pull`.
# O schema e criado sozinho na primeira conexao.
DATABASE_URL=

# Credenciais iniciais do unico operador. Sao usadas SOMENTE quando a tabela
# users esta vazia, e viram hash scrypt. Depois do primeiro login, troque a
# senha em Configuracoes > Conta: a partir dai o hash nao depende mais destas
# variaveis, e mexer nelas nao tem efeito nenhum.
NEXUS_EMAIL=
NEXUS_PASSWORD=

# Nome exibido no cockpit
NEXUS_OWNER_NAME=Alan

# Opcional: forca cookies Secure mesmo fora de producao
# NEXUS_FORCE_SECURE_COOKIES=1
