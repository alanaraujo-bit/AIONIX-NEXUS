# --- AIONIX NEXUS ---------------------------------------------------------
# Assina os tokens de sessao (HMAC-SHA256). OBRIGATORIO em producao, minimo
# 32 caracteres — sem ele o app se recusa a emitir sessao. Trocar o valor
# invalida todas as sessoes ativas. Gere com:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
NEXUS_SECRET=

# Caminho do banco SQLite. Em producao aponte para um volume persistente.
# Local (padrao):  ./data/nexus.db
# Railway:         /data/nexus.db
NEXUS_DB_PATH=./data/nexus.db

# Credenciais iniciais do unico operador. Sao usadas apenas na primeira
# inicializacao (ou por `npm run nexus:user`) e viram hash Argon-like (scrypt).
NEXUS_EMAIL=
NEXUS_PASSWORD=

# Nome exibido no cockpit
NEXUS_OWNER_NAME=Alan

# Opcional: forca cookies Secure mesmo fora de producao
# NEXUS_FORCE_SECURE_COOKIES=1
